
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101114">
<title>MHD Fadlan Qaddafi — Portfolio</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
    --bg: #101114;
    --surface: #17191e;
    --surface2: #1d2027;
    --text: #f1f2f4;
    --muted: #969ba6;
    --line: #292c34;
    --accent: #76a9ff;
    --accent-soft: rgba(118,169,255,.12);
}

body.light {
    --bg: #f5f6f8;
    --surface: #ffffff;
    --surface2: #edf0f5;
    --text: #17191e;
    --muted: #666e7b;
    --line: #e1e4e9;
    --accent: #2769d8;
    --accent-soft: rgba(39,105,216,.09);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    transition: background .3s, color .3s;
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    font: inherit;
}

/* NAVIGATION */

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
}

.nav-container {
    max-width: 1150px;
    margin: auto;
    height: 76px;
    padding: 0 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-family: 'Manrope', sans-serif;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    color: var(--accent);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
}

.nav-links a {
    color: var(--muted);
    font-size: 13px;
    transition: .25s;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--accent);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.theme-btn, .menu-btn {
    width: 39px;
    height: 39px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 10px;
    cursor: pointer;
    font-size: 17px;
}

.menu-btn {
    display: none;
}

/* GENERAL */

.container {
    max-width: 1050px;
    margin: auto;
    padding: 0 25px;
}

section {
    padding: 105px 0;
}

.section-label {
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.section-title {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(29px, 4vw, 39px);
    line-height: 1.25;
    letter-spacing: -1.5px;
}

.section-desc {
    color: var(--muted);
    max-width: 560px;
    font-size: 14px;
    margin-top: 13px;
}

/* HERO */

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 110px;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: "";
    position: absolute;
    width: 450px;
    height: 450px;
    right: -130px;
    top: 15%;
    background: var(--accent);
    opacity: .07;
    filter: blur(120px);
    border-radius: 50%;
}

.hero-content {
    position: relative;
    z-index: 1;
}

.availability {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 7px 13px;
    border-radius: 30px;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 30px;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #53c98b;
    box-shadow: 0 0 10px #53c98b;
}

.hero h1 {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(43px, 7.5vw, 83px);
    font-weight: 800;
    letter-spacing: -4px;
    line-height: 1.08;
    max-width: 800px;
}

.hero h1 span {
    color: var(--accent);
}

.hero-description {
    color: var(--muted);
    font-size: 15px;
    max-width: 550px;
    margin-top: 24px;
    line-height: 1.9;
}

.hero-buttons {
    display: flex;
    gap: 13px;
    flex-wrap: wrap;
    margin-top: 34px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    transition: .25s;
    cursor: pointer;
}

.btn-primary {
    background: var(--accent);
    color: #101114;
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px var(--accent-soft);
}

.btn-outline {
    border: 1px solid var(--line);
    color: var(--text);
}

.btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
}

.hero-bottom {
    margin-top: 80px;
    padding-top: 23px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 1px;
}

/* ABOUT */

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 65px;
    margin-top: 45px;
    align-items: start;
}

.profile-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 25px;
}

.profile-initial {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 250px;
    border-radius: 10px;
    background: var(--surface2);
    display: grid;
    place-items: center;
    font-family: 'Manrope', sans-serif;
    font-size: 75px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -5px;
}

.profile-caption {
    margin-top: 20px;
}

.profile-caption h3 {
    font-size: 17px;
}

.profile-caption p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 3px;
}

.about-text p {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 17px;
}

.info-list {
    border-top: 1px solid var(--line);
    margin-top: 25px;
}

.info-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
}

.info-row span:first-child {
    color: var(--muted);
}

.info-row span:last-child {
    text-align: right;
    font-weight: 600;
}

/* SKILLS */

.skills-section {
    background: var(--surface);
}

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 40px;
}

.skill-card {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    transition: .3s;
}

.skill-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
}

.skill-icon {
    font-size: 25px;
    margin-bottom: 17px;
}

.skill-card h3 {
    font-size: 15px;
    margin-bottom: 9px;
}

.skill-card p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.8;
}

/* EXPERIENCE */

.timeline {
    margin-top: 42px;
    border-left: 1px solid var(--line);
    margin-left: 7px;
    padding-left: 30px;
}

.timeline-item {
    position: relative;
    padding-bottom: 37px;
}

.timeline-item::before {
    content: "";
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    left: -36px;
    top: 7px;
    box-shadow: 0 0 12px var(--accent-soft);
}

.timeline-date {
    font-size: 11px;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 1px;
}

.timeline-item h3 {
    font-size: 17px;
    margin: 8px 0;
}

.timeline-item p {
    font-size: 13px;
    color: var(--muted);
    max-width: 600px;
}

/* PROJECTS */

.projects-section {
    background: var(--surface);
}

.project-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 30px 0;
}

.filter-btn {
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--muted);
    padding: 8px 16px;
    border-radius: 7px;
    font-size: 12px;
    cursor: pointer;
    transition: .2s;
}

.filter-btn.active,
.filter-btn:hover {
    background: var(--accent);
    color: #101114;
    border-color: var(--accent);
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 17px;
}

.project-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 25px;
    transition: .3s;
}

.project-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
}

.project-card.hide {
    display: none;
}

.project-number {
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
}

.project-card h3 {
    margin: 17px 0 10px;
    font-size: 18px;
}

.project-card p {
    color: var(--muted);
    font-size: 13px;
    min-height: 68px;
}

.project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 22px;
}

.project-tags span {
    font-size: 10px;
    padding: 5px 9px;
    border-radius: 5px;
    background: var(--accent-soft);
    color: var(--accent);
}

/* CONTACT */

.contact-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 55px 30px;
    text-align: center;
}

.contact-box h2 {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(30px, 5vw, 46px);
    letter-spacing: -2px;
}

.contact-box h2 span {
    color: var(--accent);
}

.contact-box p {
    color: var(--muted);
    font-size: 13px;
    margin: 15px auto 25px;
    max-width: 450px;
}

.contact-note {
    color: var(--muted);
    font-size: 11px;
    margin-top: 15px;
}

/* FOOTER */

footer {
    border-top: 1px solid var(--line);
    padding: 25px;
}

.footer-inner {
    max-width: 1050px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: var(--muted);
    font-size: 11px;
}

footer strong {
    color: var(--accent);
}

/* REVEAL */

.reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity .7s ease, transform .7s ease;
}

.reveal.show {
    opacity: 1;
    transform: translateY(0);
}

/* RESPONSIVE */

@media(max-width: 760px) {
    .menu-btn {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 76px;
        left: 0;
        width: 100%;
        background: var(--surface);
        border-bottom: 1px solid var(--line);
        padding: 20px 25px;
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
    }

    .nav-links.open {
        display: flex;
    }

    .hero h1 {
        letter-spacing: -2.5px;
    }

    .about-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .profile-initial {
        max-height: 220px;
    }

    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    section {
        padding: 80px 0;
    }
}

@media(max-width: 420px) {
    .skills-grid {
        grid-template-columns: 1fr;
    }

    .hero-bottom {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .footer-inner {
        flex-direction: column;
    }
}

@media(prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
    }
}
</style>
</head>

